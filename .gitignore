# Ignore node_modules directory
node_modules/

# Ignore log files
*.log

# Ignore environment variables file (and any backup/variant copies)
.env
.env.*
!.env.example

# Ignore build output
dist/
build/
*.tsbuildinfo

# Ignore temporary files
*.tmp
*.swp

# Ignore OS generated files
.DS_Store
Thumbs.db

# Volcados completos de colecciones que deja `npm run media:respaldo` antes de un --apply.
# Se quedan en la maquina: son la red de seguridad de QUIEN corre el script, no codigo, y son
# cientos de KB de datos de produccion. Los reportes `media-backfill-*.json` SI se versionan:
# son la lista de rutas y valores previos que usa `--rollback`, y el equipo los necesita.
respaldos/pre-backfill-*/
